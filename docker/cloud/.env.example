# 独立演示环境变量样例。实际使用时由 bin/build-cloud.ps1 生成 .env（随机值、已被忽略）
# 不要提交真实 .env；不要把这些值写进 Nacos 配置或镜像

# 平台 MySQL（ry-cloud 库）
DQ_DB_ROOT_PASSWORD=change-me-root
DQ_DB_USER=ry
DQ_DB_PASSWORD=change-me-app

# 平台 Redis
DQ_REDIS_PASSWORD=change-me-redis

# dqservice 外部凭据加密密钥：Base64 编码的 32 字节，两个副本必须一致
DQ_SOURCE_AES_KEY=change-me-32-byte-base64

# 独立演示数据源（只读账号用于页面配置外部连接）
DQ_SRC_ROOT_PASSWORD=change-me-src-root
DQ_SRC_READER_USER=dq_reader
DQ_SRC_READER_PASSWORD=change-me-src-reader

# 本机仅绑定回环地址的访问端口
DQ_HTTP_PORT=18080
